(version 1)

; The runner supplies all paths with -D. Reads are unrestricted; writes are
; limited to the project, this profile's mutable state, temporary directories,
; and normal local caches.
(allow default)
(deny file-write*)
(allow file-write*
    (subpath (param "PROJECT"))
    (subpath (param "PROFILE_DIR"))
    (subpath (param "TMP_DIR"))
    (subpath (param "VAR_TMP_DIR"))
    (subpath (param "TMP_FOLDERS_DIR"))
    (subpath (param "CACHE_HOME"))
    (subpath (param "USER_CACHE"))
    (literal "/dev/null")
    (literal "/dev/tty")
    (literal "/dev/dtracehelper"))

; These paths are explicitly denied after the broad read/default rules.
(deny file-write* (subpath (param "BATON_TASKS")))
(deny file-write* (subpath (param "BATON_REVIEWS")))
(deny file-write* (subpath (param "BATON_HOME")))
(allow file-write* (subpath (param "PROFILE_DIR")))
(deny file-write* (literal (param "PROFILE_SOUL")))
(deny file-write* (literal (param "PROFILE_CONFIG")))
(deny file-write* (literal (param "PROFILE_ENV")))
(deny file-write* (subpath (param "CLAUDE_HOME")))
