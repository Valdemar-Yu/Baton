{
  "_comment": "Baton v3 defaults (Agy-core Research Baton: prioritizes agy Opus quota, falls back to claude-00/01/02 via claude-accounts). Deep-merges: this skill config.json, <project>/.baton/config.json, then <project>/baton.json. Project quota.* is ignored.",
  "version": 3,
  "conductor": {
    "backend": "agy",
    "model": "gemini-4-carbon-high",
    "reasoning_effort": "high",
    "council_for_major_decisions": false,
    "service_tier": "priority",
    "disable_fast_mode": false
  },
  "advisor": {
    "enabled": true,
    "backend": "agy",
    "model": "gemini-4-neon-xhigh",
    "reasoning_effort": "xhigh",
    "timeout_minutes": 20,
    "design_gate": true,
    "escalate_on_revise_streak": 2,
    "handle_final_audit": true,
    "handle_violation_audit": true
  },
  "monitor": {
    "enabled": true,
    "backend": "agy",
    "model": "gemini-4-hydrogen-xhigh",
    "reasoning_effort": "xhigh",
    "final_reasoning_effort": "xhigh",
    "timeout_minutes": 30,
    "midleg_llm_checks": false,
    "midleg_llm_on_alert": false
  },
  "executor": {
    "backend": "agy",
    "model": "claude-opus-5-5-high",
    "reasoning_effort": "high",
    "claude_bin": "claude-00",
    "permission_mode": "bypassPermissions",
    "safe_mode": true,
    "disallowed_tools": [
      "Bash(baton *)",
      "Bash(git push*)",
      "Bash(rm -rf /*)"
    ],
    "max_legs_per_session": 4,
    "hermes_profile": "baton-exec-v2",
    "provider": "openai-codex",
    "toolsets": ["file", "terminal", "todo", "baton-memory"],
    "sandbox_exec": true,
    "escalation": {
      "enabled": false,
      "model": "claude-opus-5-5-high",
      "reasoning_effort": "high",
      "after_revise": 2,
      "after_blocked_or_failed_legs": 2,
      "max_per_task": 2
    },
    "service_tier": "priority",
    "disable_fast_mode": false,
    "sandbox": "workspace-write",
    "network_access": false,
    "capacity_retry": {
      "immediate": 3,
      "delayed": 1,
      "delayed_minutes": 15
    },
    "extra_config": []
  },
  "memory": {
    "backend": "mem0",
    "embedder": {"provider": "ollama", "model": "qwen3-embedding:0.6b", "num_ctx": 1024, "dims": 1024},
    "inject_top_k": 10,
    "core_max_chars": 2200,
    "curation_model": "gemini-4-hydrogen-high"
  },
  "mode": "standard",
  "supervision": {
    "interval_minutes": 30,
    "max_unsupervised_minutes": 70,
    "first_check_minutes": 10,
    "max_check_minutes": 60,
    "unhandled_stop_minutes": 30,
    "rule_check_seconds": 60,
    "check_summary_max_chars": 300,
    "alerts": {
      "delete_ratio": 3,
      "stall_minutes": 20,
      "repeat_fail": 3
    },
    "test_command": "",
    "verify_timeout_minutes": 30
  },
  "approvals": {
    "delegate_to_conductor": false
  },
  "freeze": {
    "paths": [],
    "check_seconds": 60
  },
  "quota": {
    "warn_remaining_percent": 5,
    "cache_seconds": 120,
    "desktop_notify": true
  },
  "change_size": {
    "major_files": 4,
    "major_lines": 200
  },
  "language": "中文"
}
