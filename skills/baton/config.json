{
  "_comment": "Baton defaults. Configuration deep-merges in this order: this skill config.json, <project>/.baton/config.json, then <project>/baton.json. Project quota.* is ignored; quota is per account and read from this file only. BATON_QUOTA_WARN_PERCENT and BATON_DESKTOP_NOTIFY=0 override it per shell.",
  "conductor": {
    "model": "gpt-6-astra",
    "council_for_major_decisions": true,
    "reasoning_effort": "ultra",
    "service_tier": "priority",
    "disable_fast_mode": false
  },
  "monitor": {
    "model": "gpt-5.6-luna",
    "reasoning_effort": "max",
    "final_reasoning_effort": "max",
    "timeout_minutes": 40
  },
  "executor": {
    "backend": "codex",
    "hermes_profile": "baton-exec-v2",
    "provider": "openai-codex",
    "toolsets": ["file", "terminal", "todo", "baton-memory"],
    "sandbox_exec": true,
    "model": "gpt-6.1-sol",
    "reasoning_effort": "ultra",
    "escalation": {
      "enabled": true,
      "model": "gpt-6.1-sol",
      "reasoning_effort": "ultra",
      "after_revise": 2,
      "after_blocked_or_failed_legs": 2,
      "max_per_task": 3
    },
    "service_tier": "priority",
    "disable_fast_mode": false,
    "sandbox": "workspace-write",
    "network_access": false,
    "capacity_retry": {
      "immediate": 3,
      "delayed": 1,
      "delayed_minutes": 15
    },
    "extra_config": []
  },
  "memory": {
    "backend": "mem0",
    "embedder": {"provider": "ollama", "model": "qwen3-embedding:0.6b", "num_ctx": 1024, "dims": 1024},
    "inject_top_k": 10,
    "core_max_chars": 2200,
    "curation_model": "sonnet"
  },
  "mode": "standard",
  "supervision": {
    "interval_minutes": 30,
    "max_unsupervised_minutes": 70,
    "first_check_minutes": 10,
    "max_check_minutes": 60,
    "unhandled_stop_minutes": 30,
    "rule_check_seconds": 60,
    "check_summary_max_chars": 300,
    "alerts": {
      "delete_ratio": 3,
      "stall_minutes": 20,
      "repeat_fail": 3
    },
    "test_command": "",
    "verify_timeout_minutes": 30
  },
  "approvals": {
    "delegate_to_conductor": false
  },
  "freeze": {
    "paths": [],
    "check_seconds": 60
  },
  "quota": {
    "warn_remaining_percent": 5,
    "cache_seconds": 120,
    "desktop_notify": true
  },
  "change_size": {
    "major_files": 4,
    "major_lines": 200
  },
  "language": "中文"
}
